  m_EditorClassIdentifier: Assembly-CSharp::Examinable
  key: x_window
  linesEn:
  - Bars, wired glass... and trees. Nothing but trees for miles.
  - Nobody out there would hear me scream. That's the point, I guess.
  linesPt:
  - "Grade, vidro aramado... e \xE1rvore. S\xF3 \xE1rvore por quil\xF4metros."
  - "Ningu\xE9m l\xE1 fora ia me ouvir gritar. Deve ser essa a ideia."
  clipsEn: []
  clipsPt: []
  standPoint: {fileID: 823744777}
  standDistance: 1.1
  seenFlag: 
