  references:
    version: 2
    RefIds:
    - rid: 9117351028336624347
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 1
        duration: 0
    - rid: 9117351028336624348
      type: {class: CameraCutStep, ns: , asm: Assembly-CSharp}
      data:
        camera: {fileID: 1565130730}
    - rid: 9117351028336624349
      type: {class: TeleportStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        target: {fileID: 1912530505}
    - rid: 9117351028336624350
      type: {class: ClipStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        clip: {fileID: -623603649343465320, guid: 41c2274b90a69e14b84407eb5275f9b5, type: 3}
        blend: 0
        waitEnd: 0
        backToNormal: 0
    - rid: 9117351028336624351
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1.2
    - rid: 9117351028336624352
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 0
        duration: 3
    - rid: 9117351028336624353
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1.5
    - rid: 9117351028336624354
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Helena, t\xE1 me ouvindo?"
        textEn: Helena, can you hear me?
        match: 0.6
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351028336624355
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.8
    - rid: 9117351028336624356
      type: {class: ClipStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        clip: {fileID: -623603649343465320, guid: a6529983d5653064b9ea65028780faae, type: 3}
        blend: 0.4
        waitEnd: 1
        backToNormal: 0
    - rid: 9117351028336624357
      type: {class: ClipStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        clip: {fileID: -623603649343465320, guid: 0acc15d2751e7894681af759ddcaf685, type: 3}
        blend: 0.3
        waitEnd: 0
        backToNormal: 0
    - rid: 9117351028336624358
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: "...Voc\xEA demorou."
        textEn: ...You took your time.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336624359
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: "Tr\xEAs dias fingindo que eu sou louca. Rem\xE9dio, camisa de for\xE7a,
          gente gritando a noite inteira."
        textEn: Three days pretending I'm crazy. Pills, straitjackets, people screaming
          all night.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336624360
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: "Me tiraram tudo. Arma, r\xE1dio, roupa... s\xF3 sobrou o ponto no
          ouvido. E voc\xEA."
        textEn: They took everything. Gun, radio, clothes... all I've got left is
          the earpiece. And you.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336624361
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: "Ontem \xE0 noite as luzes apagaram. Teve gritaria... e depois, sil\xEAncio.
          Sil\xEAncio demais."
        textEn: Last night the lights went out. There was screaming... and then silence.
          Too much silence.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336624362
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Vamos te tirar da\xED."
        textEn: Let's get you out of there.
        match: 0.6
        acceptAnything: 1
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351028336624363
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: "\xC9 o que eu mais quero ouvir."
        textEn: Best thing I've heard all week.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336624364
      type: {class: StateStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        state: StandUp
        blend: 0.5
        wait: 2.2
    - rid: 9117351028336624365
      type: {class: StopAnimationStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        blend: 0.4
    - rid: 9117351028336624366
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.4
    - rid: 9117351028336624367
      type: {class: FaceStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        lookAt: {fileID: 386783634}
        useTargetForward: 0
        turnSpeed: 160
    - rid: 9117351028336624368
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: "...E algu\xE9m escreveu na parede. Com sangue."
        textEn: ...And someone wrote on the wall. In blood.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336624369
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: "\"A senha est\xE1 na soma.\" Soma do qu\xEA?"
        textEn: '"The code is in the sum." The sum of what?'
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336624370
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: A porta tem um teclado. Me diz o que digitar.
        textEn: The door has a keypad. Tell me what to type.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336624371
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Ela pode olhar as coisas: \"olha a parede\", \"olha a cama\". E
          se olhar pra c\xE2mera, eu vejo ela de frente: \"olha pra mim\"."
        textEn: 'She can look at things: "look at the wall", "look at the bed". And
          facing the camera, I see her up front: "look at me".'
        wait: 1
        pauseAfter: 0.2
    - rid: 9117351028336624372
      type: {class: SetFlagStep, ns: , asm: Assembly-CSharp}
      data:
        flag: asy_awake
