MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 443071063}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27770be8b5c12ad4487a9868c55a11c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cutscene
  director: {fileID: 1052485030}
  id: asy_nurses
  once: 1
  skippable: 1
  letterbox: 1
  restoreCamera: 1
  clearScreenAtEnd: 1
  steps:
  - rid: 9117351211115479270
  - rid: 9117351211115479271
  - rid: 9117351211115479272
  - rid: 9117351211115479273
  - rid: 9117351211115479274
  - rid: 9117351211115479275
  - rid: 9117351211115479276
  - rid: 9117351211115479277
  - rid: 9117351211115479278
  - rid: 9117351211115479279
  - rid: 9117351211115479280
  - rid: 9117351211115479281
  - rid: 9117351211115479282
  - rid: 9117351211115479283
  - rid: 9117351211115479284
  references:
    version: 2
    RefIds:
    - rid: 9117351211115479270
      type: {class: CameraCutStep, ns: , asm: Assembly-CSharp}
      data:
        camera: {fileID: 1179967973}
    - rid: 9117351211115479271
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: Enfermaria. Vazia.
        textEn: Nurses station. Empty.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479272
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "O plano do Michael: \"Tr\xEAs dias. Entra como paciente, descobre
          o que est\xE3o construindo l\xE1 embaixo, sai.\""
        textEn: 'Michael''s plan: "Three days. Go in as a patient, find out what
          they''re building down there, get out."'
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479273
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "Tr\xEAs dias viraram isso. E o refor\xE7o que ele me manda \xE9
          voc\xEA."
        textEn: Three days turned into this. And the backup he sends me is you.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479274
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Eu t\xF4 aqui agora."
        textEn: I'm here now.
        match: 0.6
        acceptAnything: 1
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351211115479275
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: Agora. Depois de dois anos sumido.
        textEn: Now. After two years of disappearing.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479276
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Eu sei que a culpa \xE9 minha."
        textEn: I know it's my fault.
        match: 0.6
        acceptAnything: 1
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351211115479277
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "N\xE3o \xE9 isso que eu... Voc\xEA n\xE3o entende nada mesmo."
        textEn: That's not what I... You really don't get it.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479278
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Do que mais ela poderia estar falando?
        textEn: What else could she be talking about?
        wait: 1
        pauseAfter: 0.2
    - rid: 9117351211115479279
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1
    - rid: 9117351211115479280
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "...T\xE1. Brigar n\xE3o vai me tirar daqui."
        textEn: ...Fine. Fighting won't get me out of here.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479281
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "O mapa na parede: a sa\xEDda \xE9 pela escada, depois da guarita.
          E do lado da guarita tem o arsenal."
        textEn: 'The map on the wall: the way out is the stairwell, past the guard
          post. And the armory is right next to it.'
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479282
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "At\xE9 l\xE1... aquela faca na maca serve."
        textEn: Until then... that knife on the gurney will do.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479283
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Itens: \"pega a faca\". Armas: \"saca a faca\", \"guarda a arma\".
          Ela s\xF3 usa o que tiver pegado."
        textEn: 'Items: "pick up the knife". Weapons: "draw the knife", "put it away".
          She only uses what she has picked up.'
        wait: 1
        pauseAfter: 0.2
    - rid: 9117351211115479284
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "O mapa das c\xE2meras (Tab) mostra as salas. As portas de seguran\xE7a,
          quem abre sou eu, por ele."
        textEn: The camera map (Tab) shows the rooms. The security doors are mine
          to open, from there.
        wait: 1
        pauseAfter: 0.2
