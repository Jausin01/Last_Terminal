  clearScreenAtEnd: 1
  steps:
  - rid: 9117351028336623881
  - rid: 9117351028336623882
  - rid: 9117351028336623883
  - rid: 9117351028336623884
  - rid: 9117351028336623885
  - rid: 9117351028336623886
  references:
    version: 2
    RefIds:
    - rid: 9117351028336623881
      type: {class: CameraCutStep, ns: , asm: Assembly-CSharp}
      data:
        camera: {fileID: 1009176527}
    - rid: 9117351028336623882
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: "Tem algu\xE9m no fim do corredor..."
        textEn: There's someone at the end of the corridor...
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623883
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: "Ei! Voc\xEA t\xE1 bem?"
        textEn: Hey! Are you okay?
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623884
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1.5
    - rid: 9117351028336623885
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: "...Ele t\xE1 comendo. Ele t\xE1 COMENDO algu\xE9m."
        textEn: ...He's eating. He's EATING someone.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623886
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: 'Combate: "saca a pistola", "atira". Se chegar perto: "desvia", "recua".
          "Recarrega" quando acabar.'
        textEn: 'Combat: "draw the pistol", "shoot". If it gets close: "dodge", "back
          off". "Reload" when it''s empty.'
        wait: 1
        pauseAfter: 0.2
