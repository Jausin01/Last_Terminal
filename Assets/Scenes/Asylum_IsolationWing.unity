  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Examinable
  key: x_cabinet
  linesEn:
  - Construction invoices. Cement, steel beams, cooling units... "Sublevel B".
  - Cooling units in a mental asylum. Whatever's down there runs hot.
  - Signed and stamped by the last administration. Michael was right.
  linesPt:
  - "Notas de obra. Cimento, viga de a\xE7o, unidades de resfriamento... \"Subn\xEDvel
    B\"."
  - "Resfriamento num hosp\xEDcio. Seja l\xE1 o que tem l\xE1 embaixo, esquenta."
  - "Assinado e carimbado pelo governo anterior. O Michael tinha raz\xE3o."
  clipsEn: []
  clipsPt: []
  standPoint: {fileID: 0}
  standDistance: 1.1
  seenFlag: 
