  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Examinable
  key: x_body
  linesEn:
  - A guard. He put up a fight... someone did this with their bare hands.
  - His keycard fell out of his belt. I'll need it for the armory.
  linesPt:
  - "Um guarda. Ele lutou... algu\xE9m fez isso com as m\xE3os."
  - "O cart\xE3o de acesso dele caiu do cinto. Vou precisar disso pro arsenal."
  clipsEn: []
  clipsPt: []
  standPoint: {fileID: 0}
  standDistance: 1.1
  seenFlag: 
