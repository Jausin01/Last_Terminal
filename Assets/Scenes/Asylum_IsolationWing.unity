MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1201698828}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27770be8b5c12ad4487a9868c55a11c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cutscene
  director: {fileID: 1052485030}
  id: asy_corridor
  once: 1
  skippable: 1
  letterbox: 1
  restoreCamera: 1
  clearScreenAtEnd: 1
  steps:
  - rid: 9117351211115479299
  - rid: 9117351211115479300
  - rid: 9117351211115479301
  - rid: 9117351211115479302
  - rid: 9117351211115479303
  - rid: 9117351211115479304
  - rid: 9117351211115479305
  references:
    version: 2
    RefIds:
    - rid: 9117351211115479299
      type: {class: CameraCutStep, ns: , asm: Assembly-CSharp}
      data:
        camera: {fileID: 1550754349}
    - rid: 9117351211115479300
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "Tem algu\xE9m no fim do corredor..."
        textEn: There's someone at the end of the corridor...
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479301
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "Ei! Voc\xEA t\xE1 bem?"
        textEn: Hey! Are you okay?
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479302
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1.5
    - rid: 9117351211115479303
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "...Ele t\xE1 comendo. Ele t\xE1 COMENDO algu\xE9m."
        textEn: ...He's eating. He's EATING someone.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479304
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Ele t\xE1 longe. \"Avan\xE7a\" pra chegar mais perto, \"saca a pistola\",
          \"atira\"."
        textEn: It's far. "Advance" to get closer, "draw the pistol", "shoot".
        wait: 1
        pauseAfter: 0.2
    - rid: 9117351211115479305
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Se chegar perto: \"recua\", \"desvia\". \"Recarrega\" quando acabar
          a muni\xE7\xE3o."
        textEn: 'If it gets close: "back off", "dodge". "Reload" when it''s empty.'
        wait: 1
        pauseAfter: 0.2
