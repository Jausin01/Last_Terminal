  director: {fileID: 1052485030}
  id: asy_first_kill
  once: 1
  skippable: 1
  letterbox: 1
  restoreCamera: 1
  clearScreenAtEnd: 1
  steps:
  - rid: 9117351211115479306
  - rid: 9117351211115479307
  - rid: 9117351211115479308
  - rid: 9117351211115479309
  references:
    version: 2
    RefIds:
    - rid: 9117351211115479306
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: ...Morreu. De novo, eu acho.
        textEn: ...It's dead. Again, I guess.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479307
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "Isso n\xE3o era um paciente. N\xE3o mais."
        textEn: That wasn't a patient. Not anymore.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479308
      type: {class: DoorStep, ns: , asm: Assembly-CSharp}
      data:
        door: {fileID: 27091846}
        action: 4
    - rid: 9117351211115479309
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: A porta da escada abriu. Vamos sair daqui.
        textEn: The stairwell door's open. Let's get out of here.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
