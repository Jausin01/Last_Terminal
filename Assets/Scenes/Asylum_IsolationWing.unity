    - rid: 9117351051715674536
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 267795787}
        speaker: 
        textPt: ...Morreu. De novo, eu acho.
        textEn: ...It's dead. Again, I guess.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351051715674537
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 267795787}
        speaker: 
        textPt: "Isso n\xE3o era um paciente. N\xE3o mais."
        textEn: That wasn't a patient. Not anymore.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351051715674538
      type: {class: DoorStep, ns: , asm: Assembly-CSharp}
