  - rid: 9117351028336623887
  - rid: 9117351028336623888
  - rid: 9117351028336623889
  - rid: 9117351028336623890
  references:
    version: 2
    RefIds:
    - rid: 9117351028336623887
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: ...Morreu. De novo, eu acho.
        textEn: ...It's dead. Again, I guess.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623888
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: "Isso n\xE3o era um paciente. N\xE3o mais."
        textEn: That wasn't a patient. Not anymore.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623889
      type: {class: DoorStep, ns: , asm: Assembly-CSharp}
      data:
        door: {fileID: 1832718824}
        action: 4
    - rid: 9117351028336623890
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: A porta da escada abriu. Vamos sair daqui.
        textEn: The stairwell door's open. Let's get out of here.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
