        toBlack: 0
        duration: 3
    - rid: 9117351211115479231
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1
    - rid: 9117351211115479232
      type: {class: ClipStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        clip: {fileID: -623603649343465320, guid: a6529983d5653064b9ea65028780faae, type: 3}
        blend: 0.4
        waitEnd: 1
        backToNormal: 0
    - rid: 9117351211115479233
      type: {class: ClipStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        clip: {fileID: -623603649343465320, guid: 0acc15d2751e7894681af759ddcaf685, type: 3}
        blend: 0.3
        waitEnd: 0
        backToNormal: 0
    - rid: 9117351211115479234
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "...Tr\xEAs dias. Ou quatro. J\xE1 perdi a conta."
        textEn: ...Three days. Maybe four. I've lost count.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479235
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "A luzinha da c\xE2mera acendeu."
        textEn: The camera light just came on.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479236
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "O Michael disse que ia mandar algu\xE9m pra ser os meus olhos. T\xE1
          atrasado."
        textEn: Michael said he'd send someone to be my eyes. You're late.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479237
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "E a\xED? Vai falar alguma coisa ou s\xF3 ficar olhando?"
        textEn: Well? Are you going to say something, or just watch?
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479238
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Helena, t\xE1 me ouvindo?"
        textEn: Helena, can you hear me?
        match: 0.6
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351211115479239
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.8
    - rid: 9117351211115479240
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: ...Espera. Essa voz.
        textEn: ...Wait. That voice.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479241
      type: {class: StateStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        state: StandUp
        blend: 0.5
        wait: 2.2
    - rid: 9117351211115479242
      type: {class: StopAnimationStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        blend: 0.4
    - rid: 9117351211115479243
      type: {class: FaceStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        lookAt: {fileID: 502729890}
        useTargetForward: 0
        turnSpeed: 160
    - rid: 9117351211115479244
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "N\xE3o. N\xE3o pode ser. Logo VOC\xCA?"
        textEn: No. No way. YOU?
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479245
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "Dois anos. Dois anos sem atender uma liga\xE7\xE3o minha."
        textEn: Two years. Two years without picking up a single one of my calls.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479246
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Ela tinha dezoito anos naquela noite.
        textEn: She was eighteen that night.
        wait: 1
        pauseAfter: 0.2
    - rid: 9117351211115479247
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1.5
    - rid: 9117351211115479248
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "Nada? Vai ficar quieto? T\xEDpico."
        textEn: Nothing? You're just going to stay quiet? Typical.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479249
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "Eu n\xE3o t\xF4 brava porque... ah, esquece. N\xE3o \xE9 hora."
        textEn: I'm not mad because... ugh, forget it. Not now.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479250
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "...T\xE1. Voc\xEA \xE9 tudo que eu tenho aqui dentro."
        textEn: ...Fine. You're all I've got in here.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479251
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "Ontem \xE0 noite as luzes apagaram. Teve gritaria... e depois, sil\xEAncio.
          Sil\xEAncio demais."
        textEn: Last night the lights went out. There was screaming... and then silence.
          Too much silence.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479252
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Vamos te tirar da\xED."
        textEn: Let's get you out of there.
        match: 0.6
        acceptAnything: 1
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351211115479253
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "Ent\xE3o come\xE7a me ajudando com isso."
        textEn: Then start by helping me with this.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479254
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.3
    - rid: 9117351211115479255
      type: {class: FaceStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        lookAt: {fileID: 15381540}
        useTargetForward: 0
        turnSpeed: 160
    - rid: 9117351211115479256
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "Algu\xE9m escreveu na parede. Com sangue."
        textEn: Someone wrote on the wall. In blood.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479257
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "\"A senha est\xE1 na soma.\" Soma do qu\xEA?"
        textEn: '"The code is in the sum." The sum of what?'
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479258
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: A porta tem um teclado. Me diz o que digitar.
        textEn: The door has a keypad. Tell me what to type.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479259
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Ela pode olhar as coisas: \"olha a parede\", \"olha a cama\". E
          se olhar pra c\xE2mera, eu vejo ela de frente: \"olha pra mim\"."
        textEn: 'She can look at things: "look at the wall", "look at the bed". And
          facing the camera, I see her up front: "look at me".'
        wait: 1
        pauseAfter: 0.2
    - rid: 9117351211115479260
      type: {class: SetFlagStep, ns: , asm: Assembly-CSharp}
      data:
        flag: asy_awake
