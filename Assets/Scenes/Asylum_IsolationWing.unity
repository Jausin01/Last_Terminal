MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1580538538}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27770be8b5c12ad4487a9868c55a11c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cutscene
  director: {fileID: 717495766}
  id: asy_corridor
  once: 1
  skippable: 1
  letterbox: 1
  restoreCamera: 1
  clearScreenAtEnd: 1
  steps:
  - rid: 9117351051715674529
  - rid: 9117351051715674530
  - rid: 9117351051715674531
  - rid: 9117351051715674532
  - rid: 9117351051715674533
  - rid: 9117351051715674534
  - rid: 9117351051715674535
  references:
    version: 2
    RefIds:
    - rid: 9117351051715674529
      type: {class: CameraCutStep, ns: , asm: Assembly-CSharp}
      data:
        camera: {fileID: 1408850217}
    - rid: 9117351051715674530
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 267795787}
        speaker: 
        textPt: "Tem algu\xE9m no fim do corredor..."
        textEn: There's someone at the end of the corridor...
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351051715674531
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 267795787}
        speaker: 
        textPt: "Ei! Voc\xEA t\xE1 bem?"
        textEn: Hey! Are you okay?
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351051715674532
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1.5
    - rid: 9117351051715674533
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 267795787}
        speaker: 
        textPt: "...Ele t\xE1 comendo. Ele t\xE1 COMENDO algu\xE9m."
        textEn: ...He's eating. He's EATING someone.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351051715674534
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Ele t\xE1 longe. \"Avan\xE7a\" pra chegar mais perto, \"saca a pistola\",
          \"atira\"."
        textEn: It's far. "Advance" to get closer, "draw the pistol", "shoot".
        wait: 1
        pauseAfter: 0.2
    - rid: 9117351051715674535
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Se chegar perto: \"recua\", \"desvia\". \"Recarrega\" quando acabar
          a muni\xE7\xE3o."
        textEn: 'If it gets close: "back off", "dodge". "Reload" when it''s empty.'
        wait: 1
        pauseAfter: 0.2
