  m_Script: {fileID: 11500000, guid: 1c23858dc4d30c04492dbb5bebec84c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Examinable
  key: x_writing
  linesEn:
  - '"The code is in the sum"... written in blood. Lovely.'
  - The sum of what? There isn't a single number in this cell...
  - Hey, you're the one with the camera. Do you see anything I don't?
  linesPt:
  - "\"A senha est\xE1 na soma\"... escrito com sangue. Que \xF3timo."
  - "Soma do qu\xEA? N\xE3o tem um n\xFAmero nessa cela..."
  - "Ei, voc\xEA \xE9 quem tem a c\xE2mera. T\xE1 vendo alguma coisa que eu n\xE3o
    t\xF4?"
  clipsEn: []
  clipsPt: []
  standPoint: {fileID: 489625242}
  standDistance: 1.1
  seenFlag: 
