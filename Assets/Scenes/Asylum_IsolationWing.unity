    - rid: 9117351028336623828
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 0
        duration: 3
    - rid: 9117351028336623829
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1.5
    - rid: 9117351028336623830
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Helena, t\xE1 me ouvindo?"
        textEn: Helena, can you hear me?
        match: 0.6
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351028336623831
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.8
    - rid: 9117351028336623832
      type: {class: ClipStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        clip: {fileID: -623603649343465320, guid: a6529983d5653064b9ea65028780faae, type: 3}
        blend: 0.4
        waitEnd: 1
        backToNormal: 0
    - rid: 9117351028336623833
      type: {class: ClipStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        clip: {fileID: -623603649343465320, guid: 0acc15d2751e7894681af759ddcaf685, type: 3}
        blend: 0.3
        waitEnd: 0
        backToNormal: 0
    - rid: 9117351028336623834
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: "...Voc\xEA demorou."
        textEn: ...You took your time.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623835
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: "Tr\xEAs dias fingindo que eu sou louca. Rem\xE9dio, camisa de for\xE7a,
          gente gritando a noite inteira."
        textEn: Three days pretending I'm crazy. Pills, straitjackets, people screaming
          all night.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623836
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: "Me tiraram tudo. Arma, r\xE1dio, roupa... s\xF3 sobrou o ponto no
          ouvido. E voc\xEA."
        textEn: They took everything. Gun, radio, clothes... all I've got left is
          the earpiece. And you.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623837
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: "Ontem \xE0 noite as luzes apagaram. Teve gritaria... e depois, sil\xEAncio.
          Sil\xEAncio demais."
        textEn: Last night the lights went out. There was screaming... and then silence.
          Too much silence.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623838
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Vamos te tirar da\xED."
        textEn: Let's get you out of there.
        match: 0.6
        acceptAnything: 1
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351028336623839
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: "\xC9 o que eu mais quero ouvir."
        textEn: Best thing I've heard all week.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623840
      type: {class: StateStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        state: StandUp
        blend: 0.5
        wait: 2.2
    - rid: 9117351028336623841
      type: {class: StopAnimationStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        blend: 0.4
    - rid: 9117351028336623842
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.4
    - rid: 9117351028336623843
      type: {class: FaceStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        lookAt: {fileID: 80637727}
        useTargetForward: 0
        turnSpeed: 160
    - rid: 9117351028336623844
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: "...E algu\xE9m escreveu na parede. Com sangue."
        textEn: ...And someone wrote on the wall. In blood.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623845
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: "\"A senha est\xE1 na soma.\" Soma do qu\xEA?"
        textEn: '"The code is in the sum." The sum of what?'
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623846
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1746997213}
        speaker: 
        textPt: A porta tem um teclado. Me diz o que digitar.
        textEn: The door has a keypad. Tell me what to type.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336623847
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Ela pode olhar as coisas: \"olha a parede\", \"olha a cama\". E
          se olhar pra c\xE2mera, eu vejo ela de frente: \"olha pra mim\"."
        textEn: 'She can look at things: "look at the wall", "look at the bed". And
          facing the camera, I see her up front: "look at me".'
        wait: 1
        pauseAfter: 0.2
    - rid: 9117351028336623848
      type: {class: SetFlagStep, ns: , asm: Assembly-CSharp}
      data:
        flag: asy_awake
