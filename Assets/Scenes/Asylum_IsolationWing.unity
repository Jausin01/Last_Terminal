  - rid: 9117351051715674523
  - rid: 9117351051715674524
  - rid: 9117351051715674525
  - rid: 9117351051715674526
  - rid: 9117351051715674527
  - rid: 9117351051715674528
  references:
    version: 2
    RefIds:
    - rid: 9117351051715674523
      type: {class: CameraCutStep, ns: , asm: Assembly-CSharp}
      data:
        camera: {fileID: 541406920}
    - rid: 9117351051715674524
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 267795787}
        speaker: 
        textPt: Saquearam quase tudo... mas sobrou uma.
        textEn: They took almost everything... but they missed one.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351051715674525
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 267795787}
        speaker: 
        textPt: Uma 1911. Velha, mas atira.
        textEn: A 1911. Old, but it shoots.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351051715674526
      type: {class: DoorStep, ns: , asm: Assembly-CSharp}
      data:
        door: {fileID: 1185470210}
        action: 3
    - rid: 9117351051715674527
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 267795787}
        speaker: 
        textPt: "Ouviu isso? Destravou alguma porta l\xE1 na guarita."
        textEn: Did you hear that? A door unlocked back in the guard post.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351051715674528
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "\"pega a pistola\", \"pega a muni\xE7\xE3o\"."
        textEn: '"pick up the pistol", "pick up the ammo".'
        wait: 1
        pauseAfter: 0.2
