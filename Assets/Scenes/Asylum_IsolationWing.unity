    RefIds:
    - rid: 9117351028336624416
      type: {class: CameraCutStep, ns: , asm: Assembly-CSharp}
      data:
        camera: {fileID: 721336974}
    - rid: 9117351028336624417
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: "A escada. O resto do hosp\xEDcio \xE9 l\xE1 em cima."
        textEn: The stairs. The rest of the asylum is up there.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336624418
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: "N\xE3o some, operador."
        textEn: Don't disappear on me, operator.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336624419
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 1
        duration: 2
    - rid: 9117351028336624420
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Fim da Ala de Isolamento.
        textEn: End of the Isolation Wing.
        wait: 1
        pauseAfter: 0.2
