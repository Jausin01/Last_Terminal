  steps:
  - rid: 9117351051715674519
  - rid: 9117351051715674520
  - rid: 9117351051715674521
  - rid: 9117351051715674522
  references:
    version: 2
    RefIds:
    - rid: 9117351051715674519
      type: {class: CameraCutStep, ns: , asm: Assembly-CSharp}
      data:
        camera: {fileID: 432488263}
    - rid: 9117351051715674520
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 267795787}
        speaker: 
        textPt: "A guarita. Esse terminal ainda liga... d\xE1 pra mandar um relat\xF3rio."
        textEn: The guard post. This terminal still works... I can send a report.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351051715674521
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Terminal: \"salva\". Aqui ela t\xE1 segura."
        textEn: 'Terminal: "save". She''s safe in here.'
        wait: 1
        pauseAfter: 0.2
    - rid: 9117351051715674522
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 267795787}
        speaker: 
        textPt: "E aquela porta \xE9 o arsenal. Trancada com cart\xE3o."
        textEn: And that door's the armory. Keycard lock.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
