--- !u!114 &303421057
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 303421054}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27770be8b5c12ad4487a9868c55a11c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cutscene
  director: {fileID: 1052485030}
  id: asy_cell_open
  once: 1
  skippable: 1
  letterbox: 0
  restoreCamera: 1
  clearScreenAtEnd: 1
  steps:
  - rid: 9117351211115479263
  - rid: 9117351211115479264
  - rid: 9117351211115479265
  - rid: 9117351211115479266
  references:
    version: 2
    RefIds:
    - rid: 9117351211115479263
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: Abriu! ...A soma. Claro.
        textEn: It's open! ...The sum. Of course.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479264
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "Voc\xEA sempre foi o bom de conta. Eu era a que chutava a porta."
        textEn: You were always the one good with numbers. I was the one who kicked
          the doors in.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479265
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: ...Era bom quando a gente fazia isso junto.
        textEn: ...It was good, when we did this together.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479266
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "T\xE1, foca. Fica de olho."
        textEn: Okay, focus. Keep watching.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
