    - rid: 9117351028336624412
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: ...Morreu. De novo, eu acho.
        textEn: ...It's dead. Again, I guess.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336624413
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: "Isso n\xE3o era um paciente. N\xE3o mais."
        textEn: That wasn't a patient. Not anymore.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351028336624414
      type: {class: DoorStep, ns: , asm: Assembly-CSharp}
      data:
        door: {fileID: 1602347461}
        action: 4
    - rid: 9117351028336624415
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1942213085}
        speaker: 
        textPt: A porta da escada abriu. Vamos sair daqui.
        textEn: The stairwell door's open. Let's get out of here.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
