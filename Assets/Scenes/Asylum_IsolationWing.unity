  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27770be8b5c12ad4487a9868c55a11c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cutscene
  director: {fileID: 1052485030}
  id: asy_guard
  once: 1
  skippable: 1
  letterbox: 1
  restoreCamera: 1
  clearScreenAtEnd: 1
  steps:
  - rid: 9117351211115479288
  - rid: 9117351211115479289
  - rid: 9117351211115479290
  - rid: 9117351211115479291
  - rid: 9117351211115479292
  references:
    version: 2
    RefIds:
    - rid: 9117351211115479288
      type: {class: CameraCutStep, ns: , asm: Assembly-CSharp}
      data:
        camera: {fileID: 1590650663}
    - rid: 9117351211115479289
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "A guarita. Esse terminal ainda liga... d\xE1 pra mandar um relat\xF3rio
          pro Michael."
        textEn: The guard post. This terminal still works... I can send Michael a
          report.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479290
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "N\xE3o que ele v\xE1 ler."
        textEn: Not that he'll read it.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479291
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Terminal: \"salva\". Aqui ela t\xE1 segura."
        textEn: 'Terminal: "save". She''s safe in here.'
        wait: 1
        pauseAfter: 0.2
    - rid: 9117351211115479292
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1680120389}
        speaker: 
        textPt: "E aquela porta \xE9 o arsenal. Trancada com cart\xE3o."
        textEn: And that door's the armory. Keycard lock.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
