  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OperatorFlavor
  labelEn: Cot
  labelPt: Catre
  linesEn:
  - Someone slept here. Not me.
  - The blanket smells like smoke.
  - ...the pillow is still warm.
  linesPt:
  - "Algu\xE9m dormiu aqui. N\xE3o fui eu."
  - "O cobertor tem cheiro de fuma\xE7a."
  - "...o travesseiro ainda est\xE1 morno."
  sound: 6
  motion: 0
  asThought: 1
