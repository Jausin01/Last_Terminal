    - rid: 9117351204681941199
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "...minha cabe\xE7a."
        textEn: ...my head.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351204681941200
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 0
        duration: 0.35
    - rid: 9117351204681941201
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.35
    - rid: 9117351204681941202
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 1
        duration: 0.15
    - rid: 9117351204681941203
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.5
    - rid: 9117351204681941204
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 0
        duration: 0.9
    - rid: 9117351204681941205
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.8
    - rid: 9117351204681941206
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Onde... eu t\xF4?"
        textEn: Where... am I?
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351204681941207
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1041339221}
        seconds: 1.8
        fieldOfView: 0
        smooth: 1
        wait: 1
    - rid: 9117351204681941208
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Isso n\xE3o \xE9 a minha casa."
        textEn: This isn't my place.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351204681941209
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 1.8
    - rid: 9117351204681941210
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 713606063}
        seconds: 2.2
        fieldOfView: 60
        smooth: 1
        wait: 1
    - rid: 9117351204681941211
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 1
    - rid: 9117351204681941212
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "A van. O vidro abrindo... aquela m\xE1scara de porco."
        textEn: The van. The glass sliding open... that pig mask.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351204681941213
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1178063095}
        seconds: 1.4
        fieldOfView: 0
        smooth: 1
        wait: 1
    - rid: 9117351204681941214
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Porta de metal. Trancada, aposto.
        textEn: A metal door. Locked, I bet.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351204681941215
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1953478580}
        seconds: 1.6
        fieldOfView: 0
        smooth: 1
        wait: 1
    - rid: 9117351204681941216
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: E a janela, lacrada.
        textEn: And the window's sealed shut.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351204681941217
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 713606063}
        seconds: 1.2
        fieldOfView: 0
        smooth: 1
        wait: 1
    - rid: 9117351204681941218
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 2.2
    - rid: 9117351204681941219
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Me apagaram e me largaram aqui feito carga.
        textEn: They knocked me out and dumped me here like cargo.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351204681941220
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Ei! Tem algu\xE9m a\xED?"
        textEn: Hey! Is anyone there?
        match: 0.5
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351204681941221
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 1
    - rid: 9117351204681941222
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 2.2
    - rid: 9117351204681941223
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Nada. Claro.
        textEn: Nothing. Of course.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351204681941224
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "\"Essa pessoa vai te levar at\xE9 um lugar seguro\"... Era isso,
          Mike?"
        textEn: '"They''ll take you somewhere safe"... This is it, Mike?'
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351204681941225
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1645138020}
        seconds: 1.8
        fieldOfView: 66
        smooth: 1
        wait: 1
    - rid: 9117351204681941226
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Quando eu sair daqui, a gente vai ter uma conversa.
        textEn: When I get out of here, you and I are going to talk.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351204681941227
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 0.35
