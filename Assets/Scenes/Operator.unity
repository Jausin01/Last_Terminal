        wait: 0
    - rid: 9117351046124929705
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1.4
    - rid: 9117351046124929706
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "...minha cabe\xE7a."
        textEn: ...my head.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351046124929707
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 0
        duration: 0.35
    - rid: 9117351046124929708
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.35
    - rid: 9117351046124929709
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 1
        duration: 0.15
    - rid: 9117351046124929710
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.5
    - rid: 9117351046124929711
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 0
        duration: 0.9
    - rid: 9117351046124929712
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.8
    - rid: 9117351046124929713
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Onde... eu t\xF4?"
        textEn: Where... am I?
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351046124929714
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1278877439}
        seconds: 1.8
        fieldOfView: 0
        smooth: 1
        wait: 1
    - rid: 9117351046124929715
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Isso n\xE3o \xE9 a minha casa."
        textEn: This isn't my place.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351046124929716
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 1.8
    - rid: 9117351046124929717
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1499983466}
        seconds: 2.2
        fieldOfView: 60
        smooth: 1
        wait: 1
    - rid: 9117351046124929718
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 1
    - rid: 9117351046124929719
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "A van. O vidro abrindo... aquela m\xE1scara de porco."
        textEn: The van. The glass sliding open... that pig mask.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351046124929720
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1716040923}
        seconds: 1.4
        fieldOfView: 0
        smooth: 1
        wait: 1
    - rid: 9117351046124929721
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Porta de metal. Trancada, aposto.
        textEn: A metal door. Locked, I bet.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351046124929722
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 753888185}
        seconds: 1.6
        fieldOfView: 0
        smooth: 1
        wait: 1
    - rid: 9117351046124929723
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: E a janela, lacrada.
        textEn: And the window's sealed shut.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351046124929724
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1499983466}
        seconds: 1.2
        fieldOfView: 0
        smooth: 1
        wait: 1
    - rid: 9117351046124929725
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 2.2
    - rid: 9117351046124929726
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Me apagaram e me largaram aqui feito carga.
        textEn: They knocked me out and dumped me here like cargo.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351046124929727
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Ei! Tem algu\xE9m a\xED?"
        textEn: Hey! Is anyone there?
        match: 0.5
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351046124929728
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 1
    - rid: 9117351046124929729
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 2.2
    - rid: 9117351046124929730
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Nada. Claro.
        textEn: Nothing. Of course.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351046124929731
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "\"Essa pessoa vai te levar at\xE9 um lugar seguro\"... Era isso,
          Mike?"
        textEn: '"They''ll take you somewhere safe"... This is it, Mike?'
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351046124929732
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 852812697}
        seconds: 1.8
        fieldOfView: 66
        smooth: 1
        wait: 1
    - rid: 9117351046124929733
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Quando eu sair daqui, a gente vai ter uma conversa.
        textEn: When I get out of here, you and I are going to talk.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351046124929734
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 0.35
