        seconds: 1.4
    - rid: 9117351051715674551
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "...minha cabe\xE7a."
        textEn: ...my head.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351051715674552
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 0
        duration: 0.35
    - rid: 9117351051715674553
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.35
    - rid: 9117351051715674554
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 1
        duration: 0.15
    - rid: 9117351051715674555
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.5
    - rid: 9117351051715674556
      type: {class: FadeStep, ns: , asm: Assembly-CSharp}
      data:
        toBlack: 0
        duration: 0.9
    - rid: 9117351051715674557
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.8
    - rid: 9117351051715674558
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Onde... eu t\xF4?"
        textEn: Where... am I?
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351051715674559
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 151239474}
        seconds: 1.8
        fieldOfView: 0
        smooth: 1
        wait: 1
    - rid: 9117351051715674560
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Isso n\xE3o \xE9 a minha casa."
        textEn: This isn't my place.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351051715674561
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 1.8
    - rid: 9117351051715674562
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1090000594}
        seconds: 2.2
        fieldOfView: 60
        smooth: 1
        wait: 1
    - rid: 9117351051715674563
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 1
    - rid: 9117351051715674564
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "A van. O vidro abrindo... aquela m\xE1scara de porco."
        textEn: The van. The glass sliding open... that pig mask.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351051715674565
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1071625424}
        seconds: 1.4
        fieldOfView: 0
        smooth: 1
        wait: 1
    - rid: 9117351051715674566
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Porta de metal. Trancada, aposto.
        textEn: A metal door. Locked, I bet.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351051715674567
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 575703702}
        seconds: 1.6
        fieldOfView: 0
        smooth: 1
        wait: 1
    - rid: 9117351051715674568
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: E a janela, lacrada.
        textEn: And the window's sealed shut.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351051715674569
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1090000594}
        seconds: 1.2
        fieldOfView: 0
        smooth: 1
        wait: 1
    - rid: 9117351051715674570
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 2.2
    - rid: 9117351051715674571
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Me apagaram e me largaram aqui feito carga.
        textEn: They knocked me out and dumped me here like cargo.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351051715674572
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Ei! Tem algu\xE9m a\xED?"
        textEn: Hey! Is anyone there?
        match: 0.5
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351051715674573
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 1
    - rid: 9117351051715674574
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 2.2
    - rid: 9117351051715674575
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Nada. Claro.
        textEn: Nothing. Of course.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351051715674576
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "\"Essa pessoa vai te levar at\xE9 um lugar seguro\"... Era isso,
          Mike?"
        textEn: '"They''ll take you somewhere safe"... This is it, Mike?'
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351051715674577
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 663603193}
        seconds: 1.8
        fieldOfView: 66
        smooth: 1
        wait: 1
    - rid: 9117351051715674578
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Quando eu sair daqui, a gente vai ter uma conversa.
        textEn: When I get out of here, you and I are going to talk.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351051715674579
      type: {class: HandheldStep, ns: , asm: Assembly-CSharp}
      data:
        amount: 0.35
