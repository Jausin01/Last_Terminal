        amount: 0.6
    - rid: 9117351051715674549
      type: {class: SoundStep, ns: , asm: Assembly-CSharp}
      data:
        clip: {fileID: 8300000, guid: 86e12cde9de93da4e94ecbccb5bdee75, type: 3}
        at: {fileID: 0}
        volume: 0.7
        wait: 0
    - rid: 9117351051715674550
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
