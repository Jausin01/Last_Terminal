  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OperatorFlavor
  labelEn: Lockers
  labelPt: "Arm\xE1rios"
  linesEn:
  - Locked. All three.
  - Something knocked in there? ...No. The air.
  - A name scratched off the middle one.
  linesPt:
  - "Trancados. Os tr\xEAs."
  - "Bateu alguma coisa l\xE1 dentro? ...N\xE3o. Foi o ar."
  - Um nome raspado no do meio.
  sound: 26
  motion: 1
  asThought: 1
