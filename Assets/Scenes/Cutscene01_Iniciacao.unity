      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1375419587}
        speaker: 
        textPt: "O governo anterior desviou mais de cinco milh\xF5es pra um hosp\xEDcio.
          Numa \xE1rea isolada, cercada de montanha e floresta."
        textEn: The last administration funneled over five million into an asylum.
          Somewhere remote, surrounded by mountains and forest.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351046124929848
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 1375419587}
        speaker: 
        textPt: "Tem alguma coisa sendo constru\xEDda embaixo dele. N\xE3o sabemos
