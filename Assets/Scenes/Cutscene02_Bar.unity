        seconds: 2.2
    - rid: 9117351211115479452
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Eu lembro dessa noite. De cada detalhe.
        textEn: I remember this night. Every detail.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351211115479453
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1947698915}
        seconds: 1.3
        fieldOfView: 38
        smooth: 1
        wait: 1
    - rid: 9117351211115479454
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 61625176}
        speaker: 
        textPt: "Voc\xEA t\xE1 sorrindo. Faz tempo que eu n\xE3o via isso."
        textEn: You're smiling. I haven't seen that in a while.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479455
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "T\xE1 tudo dando certo."
        textEn: Everything's working out.
        match: 0.6
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351211115479456
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 61625176}
        speaker: 
        textPt: "T\xE1 mesmo, n\xE9? O trabalho, a gente... at\xE9 o Jeremy parou
          de implicar com o seu carro."
        textEn: It really is, huh? Work, us... even Jeremy stopped picking on your
          car.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479457
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 227597991}
        seconds: 2.4
        fieldOfView: 16
        smooth: 1
        wait: 1
    - rid: 9117351211115479458
      type: {class: ThoughtStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: O Jeremy e a Helena. Sempre num canto, conversando.
        textEn: Jeremy and Helena. Always off in a corner, talking.
        wait: 1
        pauseAfter: 0.3
    - rid: 9117351211115479459
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1.2
    - rid: 9117351211115479460
      type: {class: CameraMoveStep, ns: , asm: Assembly-CSharp}
      data:
        to: {fileID: 1947698915}
        seconds: 1.5
        fieldOfView: 38
        smooth: 1
        wait: 1
    - rid: 9117351211115479461
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 61625176}
        speaker: 
        textPt: "Obrigada. Por ficar. Eu sei que eu n\xE3o sou f\xE1cil."
        textEn: Thank you. For staying. I know I'm not easy.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351211115479462
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Eu n\xE3o ia pra lugar nenhum."
        textEn: I wasn't going anywhere.
        match: 0.6
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
