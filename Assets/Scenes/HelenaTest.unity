  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cutscene
  director: {fileID: 438517521}
  id: intro_cell
  once: 1
  skippable: 1
  letterbox: 1
  restoreCamera: 1
  steps:
  - rid: 9117350829772505147
  - rid: 9117350829772505148
  - rid: 9117350829772505149
  - rid: 9117350829772505150
  - rid: 9117350829772505151
  - rid: 9117350829772505152
  - rid: 9117350829772505153
  - rid: 9117350829772505154
  - rid: 9117350829772505155
  - rid: 9117350829772505156
  - rid: 9117350829772505157
  - rid: 9117350829772505158
  - rid: 9117350829772505159
  - rid: 9117350829772505160
  - rid: 9117350829772505161
  - rid: 9117350829772505162
  - rid: 9117350829772505163
  - rid: 9117350829772505164
  - rid: 9117350829772505165
  - rid: 9117350829772505166
  references:
    version: 2
    RefIds:
    - rid: 9117350829772505147
      type: {class: CameraCutStep, ns: , asm: Assembly-CSharp}
      data:
        camera: {fileID: 1318068030}
    - rid: 9117350829772505148
      type: {class: StateStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        state: FloorSit
        blend: 0
        wait: 1.5
    - rid: 9117350829772505149
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        speaker: 
        textPt: "...Tr\xEAs dias. Ou quatro. J\xE1 perdi a conta."
        textEn: ...Three days. Maybe four. I've lost count.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117350829772505150
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        speaker: 
        textPt: "Essa c\xE2mera t\xE1 ligada faz uma hora e ningu\xE9m fala nada."
        textEn: That camera's been on for an hour and nobody says a word.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117350829772505151
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        speaker: 
        textPt: "Ei! Eu sei que tem algu\xE9m a\xED. A luzinha t\xE1 vermelha."
        textEn: Hey! I know someone's there. The little light is red.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117350829772505152
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        speaker: 
        textPt: Fala alguma coisa. Qualquer coisa.
        textEn: Say something. Anything.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117350829772505153
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Voc\xEA consegue me ouvir?"
        textEn: Can you hear me?
        match: 0.6
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117350829772505154
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.6
    - rid: 9117350829772505155
      type: {class: StopAnimationStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        blend: 1.1
    - rid: 9117350829772505156
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1.1
    - rid: 9117350829772505157
      type: {class: FaceStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        lookAt: {fileID: 1318068029}
        useTargetForward: 0
        turnSpeed: 160
    - rid: 9117350829772505158
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        speaker: 
        textPt: Espera... essa voz.
        textEn: Wait... that voice.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117350829772505159
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        speaker: 
        textPt: "N\xE3o. N\xE3o pode ser. Logo VOC\xCA \xE9 o meu operador?"
        textEn: No. No way. YOU are my operator?
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117350829772505160
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        speaker: 
        textPt: "De todas as pessoas do mundo... tinha que ser voc\xEA."
        textEn: Out of everyone in the world... it had to be you.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117350829772505161
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 2.5
    - rid: 9117350829772505162
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        speaker: 
        textPt: "Nada? Vai ficar quieto? T\xEDpico."
        textEn: Nothing? You're just gonna stay quiet? Typical.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117350829772505163
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        speaker: 
        textPt: Frango medroso.
        textEn: Chicken.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117350829772505164
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        speaker: 
        textPt: "...T\xE1. Eu n\xE3o tenho escolha. Vou ter que aceitar isso."
        textEn: ...Fine. I don't have a choice. I'll have to live with it.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117350829772505165
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 812121505}
        speaker: 
        textPt: Vamo logo, me tira daqui.
        textEn: Come on, get me out of here.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117350829772505166
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Sim.
        textEn: Yes.
        match: 0.6
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
