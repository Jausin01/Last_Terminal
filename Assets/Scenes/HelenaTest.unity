MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 139144727}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27770be8b5c12ad4487a9868c55a11c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cutscene
  director: {fileID: 1615334121}
  id: intro_cell
  once: 1
  skippable: 1
  letterbox: 1
  restoreCamera: 1
  clearScreenAtEnd: 1
  steps:
  - rid: 9117351138014003259
  - rid: 9117351138014003260
  - rid: 9117351138014003261
  - rid: 9117351138014003262
  - rid: 9117351138014003263
  - rid: 9117351138014003264
  - rid: 9117351138014003265
  - rid: 9117351138014003266
  - rid: 9117351138014003267
  - rid: 9117351138014003268
  - rid: 9117351138014003269
  - rid: 9117351138014003270
  - rid: 9117351138014003271
  - rid: 9117351138014003272
  - rid: 9117351138014003273
  - rid: 9117351138014003274
  - rid: 9117351138014003275
  - rid: 9117351138014003276
  - rid: 9117351138014003277
  - rid: 9117351138014003278
  references:
    version: 2
    RefIds:
    - rid: 9117351138014003259
      type: {class: CameraCutStep, ns: , asm: Assembly-CSharp}
      data:
        camera: {fileID: 799080392}
    - rid: 9117351138014003260
      type: {class: StateStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        state: FloorSit
        blend: 0
        wait: 1.5
    - rid: 9117351138014003261
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        speaker: 
        textPt: "...Tr\xEAs dias. Ou quatro. J\xE1 perdi a conta."
        textEn: ...Three days. Maybe four. I've lost count.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351138014003262
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        speaker: 
        textPt: "Essa c\xE2mera t\xE1 ligada faz uma hora e ningu\xE9m fala nada."
        textEn: That camera's been on for an hour and nobody says a word.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351138014003263
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        speaker: 
        textPt: "Ei! Eu sei que tem algu\xE9m a\xED. A luzinha t\xE1 vermelha."
        textEn: Hey! I know someone's there. The little light is red.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351138014003264
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        speaker: 
        textPt: Fala alguma coisa. Qualquer coisa.
        textEn: Say something. Anything.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351138014003265
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Voc\xEA consegue me ouvir?"
        textEn: Can you hear me?
        match: 0.6
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351138014003266
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.6
    - rid: 9117351138014003267
      type: {class: StopAnimationStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        blend: 1.1
    - rid: 9117351138014003268
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1.1
    - rid: 9117351138014003269
      type: {class: FaceStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        lookAt: {fileID: 799080391}
        useTargetForward: 0
        turnSpeed: 160
    - rid: 9117351138014003270
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        speaker: 
        textPt: Espera... essa voz.
        textEn: Wait... that voice.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351138014003271
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        speaker: 
        textPt: "N\xE3o. N\xE3o pode ser. Logo VOC\xCA \xE9 o meu operador?"
        textEn: No. No way. YOU are my operator?
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351138014003272
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        speaker: 
        textPt: "De todas as pessoas do mundo... tinha que ser voc\xEA."
        textEn: Out of everyone in the world... it had to be you.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351138014003273
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 2.5
    - rid: 9117351138014003274
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        speaker: 
        textPt: "Nada? Vai ficar quieto? T\xEDpico."
        textEn: Nothing? You're just gonna stay quiet? Typical.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351138014003275
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        speaker: 
        textPt: Frango medroso.
        textEn: Chicken.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351138014003276
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        speaker: 
        textPt: "...T\xE1. Eu n\xE3o tenho escolha. Vou ter que aceitar isso."
        textEn: ...Fine. I don't have a choice. I'll have to live with it.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351138014003277
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 411485664}
        speaker: 
        textPt: Vamo logo, me tira daqui.
        textEn: Come on, get me out of here.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351138014003278
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Sim.
        textEn: Yes.
        match: 0.6
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
