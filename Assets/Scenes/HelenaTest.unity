  - rid: 9117351142290096198
  - rid: 9117351142290096199
  - rid: 9117351142290096200
  - rid: 9117351142290096201
  - rid: 9117351142290096202
  - rid: 9117351142290096203
  - rid: 9117351142290096204
  - rid: 9117351142290096205
  - rid: 9117351142290096206
  references:
    version: 2
    RefIds:
    - rid: 9117351142290096187
      type: {class: CameraCutStep, ns: , asm: Assembly-CSharp}
      data:
        camera: {fileID: 303853708}
    - rid: 9117351142290096188
      type: {class: StateStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        state: FloorSit
        blend: 0
        wait: 1.5
    - rid: 9117351142290096189
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        speaker: 
        textPt: "...Tr\xEAs dias. Ou quatro. J\xE1 perdi a conta."
        textEn: ...Three days. Maybe four. I've lost count.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351142290096190
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        speaker: 
        textPt: "Essa c\xE2mera t\xE1 ligada faz uma hora e ningu\xE9m fala nada."
        textEn: That camera's been on for an hour and nobody says a word.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351142290096191
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        speaker: 
        textPt: "Ei! Eu sei que tem algu\xE9m a\xED. A luzinha t\xE1 vermelha."
        textEn: Hey! I know someone's there. The little light is red.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351142290096192
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        speaker: 
        textPt: Fala alguma coisa. Qualquer coisa.
        textEn: Say something. Anything.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351142290096193
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: "Voc\xEA consegue me ouvir?"
        textEn: Can you hear me?
        match: 0.6
        acceptAnything: 0
        showSubtitle: 1
        speakerPt: "VOC\xCA"
        speakerEn: YOU
    - rid: 9117351142290096194
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 0.6
    - rid: 9117351142290096195
      type: {class: StopAnimationStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        blend: 1.1
    - rid: 9117351142290096196
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 1.1
    - rid: 9117351142290096197
      type: {class: FaceStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        lookAt: {fileID: 303853707}
        useTargetForward: 0
        turnSpeed: 160
    - rid: 9117351142290096198
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        speaker: 
        textPt: Espera... essa voz.
        textEn: Wait... that voice.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351142290096199
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        speaker: 
        textPt: "N\xE3o. N\xE3o pode ser. Logo VOC\xCA \xE9 o meu operador?"
        textEn: No. No way. YOU are my operator?
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351142290096200
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        speaker: 
        textPt: "De todas as pessoas do mundo... tinha que ser voc\xEA."
        textEn: Out of everyone in the world... it had to be you.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351142290096201
      type: {class: WaitStep, ns: , asm: Assembly-CSharp}
      data:
        seconds: 2.5
    - rid: 9117351142290096202
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        speaker: 
        textPt: "Nada? Vai ficar quieto? T\xEDpico."
        textEn: Nothing? You're just gonna stay quiet? Typical.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351142290096203
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        speaker: 
        textPt: Frango medroso.
        textEn: Chicken.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351142290096204
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        speaker: 
        textPt: "...T\xE1. Eu n\xE3o tenho escolha. Vou ter que aceitar isso."
        textEn: ...Fine. I don't have a choice. I'll have to live with it.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351142290096205
      type: {class: SayStep, ns: , asm: Assembly-CSharp}
      data:
        actor: {fileID: 285677713}
        speaker: 
        textPt: Vamo logo, me tira daqui.
        textEn: Come on, get me out of here.
        audioPt: {fileID: 0}
        audioEn: {fileID: 0}
        wait: 1
        pauseAfter: 0.35
    - rid: 9117351142290096206
      type: {class: OperatorLineStep, ns: , asm: Assembly-CSharp}
      data:
        textPt: Sim.
        textEn: Yes.
        match: 0.6
        acceptAnything: 0
